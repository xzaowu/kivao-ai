{
  "name": "@kivao/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "openapi": "tsx src/export-openapi.ts",
    "db:generate": "node --env-file-if-exists=../../.env --import tsx ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=../../.env --import tsx ./node_modules/drizzle-kit/bin.cjs migrate"
  },
  "dependencies": {
    "@kivao/contracts": "workspace:*",
    "@fastify/swagger": "9.9.2",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "5.1.0",
    "zod": "4.6.7",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@kivao/config": "workspace:*",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
