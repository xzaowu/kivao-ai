        },
        {
          "id": "detail",
          "label": "商品细节图",
          "required": false,
          "media": "image",
          "demo": "tea-detail",
          "help": "补充材质和包装细节，帮助核对真实外观。"
        }
      ],
      "checks": [
        "商品外观与包装信息一致",
        "文字和品牌标识可用",
        "每张图的用途与构图合适"
