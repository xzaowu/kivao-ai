      "adjustments": ["背景更简洁", "强化材质细节", "减少装饰元素"],
      "config": [
        {
          "key": "channel",
          "label": "使用渠道",
          "options": ["电商上新", "社媒发布", "品牌官网"]
        },
        {
          "key": "style",
          "label": "画面方向",
          "options": ["自然日光", "极简影棚", "温暖生活感"]
        },
        {
          "key": "count",
          "label": "套图结构",
          "options": [
            ["4", "4 张 · 基础上新"],
            ["6", "6 张 · 多渠道延展"]
