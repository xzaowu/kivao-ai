{
  "extends": "./packages/config/tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": [
    "vitest.config.ts",
    "apps/**/*.test.ts",
    "packages/**/*.test.ts",
    "apps/api/drizzle.config.ts",
    "packages/config/vite.ts",
    "playwright.config.ts",
    "apps/web/e2e/**/*.ts",
    "apps/admin/e2e/**/*.ts",
    "apps/admin/playwright.config.ts"
  ]
}
