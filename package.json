{
  "name": "kivao-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "pnpm build:packages && pnpm -r --parallel --if-present dev",
    "dev:web": "pnpm build:packages && pnpm --filter @kivao/web dev",
    "dev:admin": "pnpm build:packages && pnpm --filter @kivao/admin dev",
    "dev:api": "pnpm build:packages && pnpm --filter @kivao/api dev",
    "dev:worker": "pnpm --filter @kivao/worker dev",
    "build:packages": "pnpm --filter './packages/**' -r --if-present build",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm build:packages && pnpm -r --if-present typecheck && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm build:packages && vitest run",
    "openapi": "pnpm build:packages && pnpm --filter @kivao/api openapi",
    "db:generate": "pnpm --filter @kivao/api db:generate",
    "db:migrate": "pnpm --filter @kivao/api db:migrate",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "0.25.12"
    }
  }
}
